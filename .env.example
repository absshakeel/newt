# Environment Variables

# MongoDB
MONGODB_URI=mongodb://localhost:27017/gtour

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production

# Server Port
PORT=5000

# Frontend URL (web app)
FRONTEND_URL=http://localhost:3000

# Admin app URL (separate admin frontend)
ADMIN_URL=http://localhost:3001

# Optional: comma-separated additional allowed CORS origins
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Node Environment
NODE_ENV=development

# Cloudflare R2 (S3-compatible) - used for image uploads
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
# Public base URL for uploaded objects (e.g. https://pub-xxxx.r2.dev or your custom domain), no trailing slash
R2_PUBLIC_URL=https://your-public-r2-domain
# Optional key prefix inside bucket (default: uploads)
R2_UPLOAD_PREFIX=uploads